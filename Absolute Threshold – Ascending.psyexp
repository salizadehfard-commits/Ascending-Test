        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((key_resp.keys === &quot;space&quot;)) {&amp;#10;    RT = key_resp.rt;&amp;#10;    psychoJS.experiment.addData(&quot;Threshold&quot;, Intensity);&amp;#10;    psychoJS.experiment.addData(&quot;RT&quot;, RT);&amp;#10;    ascendingLoop.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if key_resp.keys == 'space':&amp;#10;    RT = key_resp.rt&amp;#10;&amp;#10;    thisExp.addData('Threshold', Intensity)&amp;#10;    thisExp.addData('RT', RT)&amp;#10;&amp;#10;    ascendingLoop.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
